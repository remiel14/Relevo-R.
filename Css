* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 20px;
    font-family: Arial, sans-serif;
    background-color: #f3f5f7;
}

.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
}

header {
    text-align: center;
    margin-bottom: 25px;
}

header h1 {
    margin-bottom: 8px;
    color: #222;
}

header p {
    margin-top: 0;
    color: #666;
}

form {
    background-color: white;
    padding: 20px;
    margin-bottom: 25px;
    border: 1px solid #ddd;
}

label {
    display: block;
    margin-top: 12px;
    margin-bottom: 6px;
}

input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
}

button {
    padding: 10px 15px;
    margin-top: 15px;
    border: none;
    background-color: #333;
    color: white;
    cursor: pointer;
}

.students h2 {
    margin-bottom: 15px;
}

.student-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
}

.card {
    background-color: white;
    padding: 15px;
    border: 1px solid #ddd;
}

.card h3 {
    margin-top: 0;
}

.remove-btn {
    background-color: #c0392b;
}

/* Tablet */
@media (max-width: 900px) {
    .student-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

/* Mobile */
@media (max-width: 600px) {
    .student-grid {
        grid-template-columns: 1fr;
    }
}
